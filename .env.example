# Supabase → Project Settings → API (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ── Local scripts only (npm run images:fetch). Never prefix these with NEXT_PUBLIC_. ──
# Supabase → Project Settings → API Keys → secret key
SUPABASE_SECRET_KEY=
# https://pixabay.com/api/docs/ (free)
PIXABAY_API_KEY=
# https://console.anthropic.com → API keys (npm run seed:translate / seed:examples — Claude drafts)
ANTHROPIC_API_KEY=

# ── Daily reminders (see README → Daily reminders). Generate: npx web-push generate-vapid-keys ──
# Public key: safe for the browser.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Server-only (Vercel env + .env.local). SUPABASE_SECRET_KEY above is also needed by /api/reminders.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=
