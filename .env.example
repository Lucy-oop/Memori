# Supabase → Project Settings → API (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ── Local scripts only (npm run images:fetch). Never prefix these with NEXT_PUBLIC_. ──
# Supabase → Project Settings → API Keys → secret key
SUPABASE_SECRET_KEY=
# https://pixabay.com/api/docs/ (free)
PIXABAY_API_KEY=
